<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Debug builds run outside the sandbox so tests can open a project folder with
	     --open <path>. Release builds use Reel.entitlements (sandboxed). -->
	<!-- Same Terminal Apple Events access as release builds, for the assistant helper. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
